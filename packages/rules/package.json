{
  "name": "@regle/rules",
  "version": "1.29.4",
  "description": "Collection of rules and helpers for Regle",
  "homepage": "https://reglejs.dev/",
  "license": "MIT",
  "author": {
    "name": "Victor Garcia",
    "url": "https://github.com/victorgarciaesgi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorgarciaesgi/regle.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/regle-rules.js",
  "module": "./dist/regle-rules.js",
  "types": "./dist/regle-rules.d.ts",
  "exports": {
    ".": {
      "types": "./dist/regle-rules.d.ts",
      "production": "./dist/regle-rules.min.js",
      "development": "./dist/regle-rules.js",
      "default": "./dist/regle-rules.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vp pack",
    "build:sourcemaps": "REGLE_BUILD_MODE=sourcemap vp pack",
    "dev": "REGLE_BUILD_MODE=dev vp pack --watch",
    "test": "vp test run --root ../.. --config vitest.config.ts --project \"Rules tests*\""
  },
  "dependencies": {
    "@regle/core": "workspace:*",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vue/reactivity": "catalog:",
    "@vue/test-utils": "catalog:",
    "publint": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
